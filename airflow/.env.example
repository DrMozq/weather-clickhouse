# Create the real file on the host:
#   echo "AIRFLOW_UID=$(id -u)" > .env
AIRFLOW_UID=1000

# Key to encrypt connections and variables in the metadata database. Generate once and do not change:
#   docker compose exec airflow-scheduler python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Admin login for the web UI (default: airflow / airflow), applied by airflow-init
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=
